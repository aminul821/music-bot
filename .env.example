# Get API_ID / API_HASH from https://my.telegram.org
API_ID=
API_HASH=
# Bot token from @BotFather
BOT_TOKEN=
# Pyrogram string session of the assistant account (run: python generate_session.py)
STRING_SESSION=

# Bot name shown in messages
BOT_NAME=🥰🥳❤️ Mad Family ❤️🥰🥳 Music Bot
# Lock the bot to your group: send /id in the group and paste the id here (e.g. -1001234567890)
ALLOWED_CHATS=
# Invite link of your group (shown on /start)
GROUP_LINK=

# Your Telegram user id and extra sudo users (space or comma separated)
OWNER_ID=
SUDO_USERS=

DURATION_LIMIT=180
QUEUE_LIMIT=50
# high (48 kHz, recommended) | studio (96 kHz) | medium | low
AUDIO_QUALITY=high
# 4k | 2k | 1080 | 720 | 480 | 360
VIDEO_QUALITY=1080
ADMIN_ONLY=true

# Optional: cookies.txt exported from a logged-in YouTube browser session
COOKIES_FILE=
# Optional: proxy for YouTube (residential proxies avoid the 'Sign in to confirm' block)
YT_PROXY=
# Optional: YouTube player clients tried first (comma separated)
YT_CLIENTS=
DOWNLOAD_DIR=downloads

SUPPORT_CHAT=
UPDATES_CHANNEL=
START_IMG=

# Touch Grass: open-weight model served by Ollama (https://ollama.com), e.g. `ollama pull gemma3:4b`
OLLAMA_URL=http://localhost:11434
GRASS_MODEL=gemma3:4b
# Hours of non-stop voice chat before the bot nudges everyone outside (0 = off)
GRASS_NUDGE_HOURS=3
# Search radius for parks / trails / viewpoints, in metres
GRASS_RADIUS=3000
