# Get API_ID / API_HASH from https://my.telegram.org
API_ID=
API_HASH=
# Bot token from @BotFather
BOT_TOKEN=
# Pyrogram string session of the assistant account (run: python generate_session.py)
STRING_SESSION=

# Your Telegram user id and extra sudo users (space or comma separated)
OWNER_ID=
SUDO_USERS=

DURATION_LIMIT=180
QUEUE_LIMIT=50
# studio | high | medium | low
AUDIO_QUALITY=studio
# 4k | 2k | 1080 | 720 | 480 | 360
VIDEO_QUALITY=1080
ADMIN_ONLY=true

# Optional: cookies.txt exported from a logged-in YouTube browser session
COOKIES_FILE=
# Optional: proxy for YouTube (residential proxies avoid the 'Sign in to confirm' block)
YT_PROXY=
# Optional: YouTube player clients tried first (comma separated)
YT_CLIENTS=
DOWNLOAD_DIR=downloads

SUPPORT_CHAT=
UPDATES_CHANNEL=
START_IMG=
